# All settings are optional; defaults shown.
ROLLETTO_ENVIRONMENT=development
ROLLETTO_LOG_LEVEL=INFO
# JSON list of allowed browser origins (your frontend URL in production).
ROLLETTO_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ROLLETTO_CACHE_TTL_FINANCIALS_S=43200
ROLLETTO_CACHE_TTL_MARKET_S=900
ROLLETTO_PROVIDER_TIMEOUT_S=12
ROLLETTO_PROVIDER_RETRIES=3
ROLLETTO_RATE_LIMIT_DEFAULT=120/minute
ROLLETTO_RATE_LIMIT_VALUATION=30/minute
ROLLETTO_RATE_LIMIT_EXPORT=15/minute
ROLLETTO_MAX_SIMULATIONS=100000
# Override country market defaults (merged over the built-in table), e.g.:
# ROLLETTO_COUNTRY_OVERRIDES={"India":{"risk_free":0.064},"United States":{"equity_risk_premium":0.05}}
ROLLETTO_COUNTRY_OVERRIDES=
